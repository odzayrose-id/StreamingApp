<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- FRAME PEMUTAR VIDEO (Dikunci di 230dp agar stabil di mode Portrait) -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="#000000">

        <ImageView
            android:id="@+id/imgArtwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:use_controller="true" />

        <ImageView
            android:id="@+id/btnFullscreen"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:padding="6dp"
            android:background="#88000000"
            android:src="@android:drawable/ic_menu_crop"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#141414"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDetailJudul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDetailMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAAAA" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailDeskripsi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#DDDDDD"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- WADAH TOMBOL KUALITAS (Sekarang Rata Tengah) -->
            <LinearLayout
                android:id="@+id/layoutQualityButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn360p"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="360p"
                    android:backgroundTint="#E50914"
                    android:textColor="#FFFFFF"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btn480p"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="480p"
                    android:backgroundTint="#E50914"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btn720p"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="720p"
                    android:backgroundTint="#E50914"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btn1080p"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="1080p"
                    android:backgroundTint="#E50914"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- DAFTAR PEMERAN (Sekarang berada di bawah tombol kualitas) -->
            <LinearLayout
                android:id="@+id/layoutCast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pemeran :"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </LinearLayout>

            <!-- TOMBOL TELEGRAM & DOWNLOAD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnTelegram"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Play Via Telegram"
                    android:backgroundTint="#0088CC"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnDownload"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Download Video"
                    android:backgroundTint="#E50914"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="4dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- DAFTAR EPISODE -->
            <LinearLayout
                android:id="@+id/layoutEpisodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pilih Season"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:layout_marginBottom="12dp"/>

                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="45dp"
                    android:layout_marginBottom="24dp"
                    android:background="#2B2B2B">

                    <Spinner
                        android:id="@+id/spinnerSeason"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="4dp"
                        android:paddingEnd="32dp"
                        android:popupBackground="#1A1A1A" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="12dp"
                        android:src="@android:drawable/arrow_down_float"
                        app:tint="#FFFFFF"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Daftar Episode"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEpisodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>